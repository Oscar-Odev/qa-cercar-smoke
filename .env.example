# Base URL under test (default: production lab)
CERCAR_BASE_URL=https://cercar.odev.es

# Optional — enables guest API smoke (read-only share link)
# Visit /s/<token> once, then API GET health|bootstrap|get should return 200.
CERCAR_GUEST_SHARE_PATH=/s/your-share-token-here

# Optional — enables authenticated API smoke (email/password account)
CERCAR_QA_EMAIL=
CERCAR_QA_PASSWORD=
